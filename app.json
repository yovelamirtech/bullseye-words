{
  "expo": {
    "name": "בול-מילה",
    "slug": "bullseye-words",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yovelsys.bullseyewords",
      "appleTeamId": "FLVYDQ86T2",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "המידע ישמש כדי להציג לך פרסומות מותאמות יותר ולתמוך בפיתוח האפליקציה בחינם."
      }
    },
    "android": {
      "package": "com.yovelsys.bullseyewords",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FDF3E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "web3formsAccessKey": "b6b4a8e3-fc3d-4e4c-9d36-16baa3a9bf56"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FDF3E7"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4185202215539389~6455610558",
          "iosAppId": "ca-app-pub-4185202215539389~4102733783"
        }
      ],
      "expo-tracking-transparency"
    ]
  }
}
